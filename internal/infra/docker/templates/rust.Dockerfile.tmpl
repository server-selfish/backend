# ---- Build stage ----
FROM {{.DockerBaseImage}} AS builder

WORKDIR /app

# Warm the registry cache as a distinct step so fetch errors surface
# separately from compile errors. NOTE: sources must be copied first —
# cargo resolves build targets from the filesystem (src/main.rs,
# src/lib.rs, ...), so fetching with only the manifests present fails
# with "no targets specified in the manifest".
COPY . .

RUN cargo fetch

RUN {{.BuildCommand}}

# ---- Runtime stage (distroless cc: no shell, single binary only) ----
FROM {{.DockerRuntimeImage}}

WORKDIR /app

COPY --from=builder /app/target/release/{{.MainFileName}} ./{{.MainFileName}}

CMD {{.RunCommand}}
