# Build stage
FROM {{.DockerBaseImage}} AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -ldflags "-s -w" -o app .
RUN apk update && apk add upx

RUN upx --best --lzma app

FROM {{.DockerRuntimeImage}}

WORKDIR /app

COPY --from=builder /app/app .

CMD {{.Command}}
