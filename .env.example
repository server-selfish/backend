# copy this file and change name to .env and fill the variable
# to be used by docker compose

# app env
ENV=production

DB_USER=
DB_PASSWORD=
DB_NAME=

# redis env
CACHE_PASSWORD=

# minio env
OS_ROOT_USER=
OS_ROOT_PASSWORD=

# auth env
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# GITHUB_AUTH_REDIRECT_URI=

# github_app env
AUTH_GITHUB_APP_ID=
AUTH_GITHUB_APP_SLUG=
AUTH_GITHUB_PRIVATE_KEY_PATH=

# github webhook env
# secret shared with the GitHub App webhook, used to sign/verify X-Hub-Signature-256.
# leave empty to keep POST /webhook/deploy disabled (answers 404).
GITHUB_WEBHOOK_SECRET=
# only pushes to this branch trigger a redeploy.
GITHUB_WEBHOOK_BRANCH=main

# jwt env
AUTH_JWT_SECRET=

# cors server env
SERVER_CORS_ALLOW_ORIGINS=https://localhost

# log env
LOG_LEVEL= "trace" | "debug" | "info" | "warn" | "error" | "fatal" | "panic"
LOG_STDOUT_ENABLED=true
LOG_STDOUT_PRETTY=true

# otel logs env (OTLP/HTTP export to VictoriaLogs)
OTEL_LOGS_ENABLED=true
OTEL_LOGS_ENDPOINT=http://localhost:9428/opentelemetry/api/v1/logs
OTEL_LOGS_INSECURE=true
OTEL_SERVICE_NAME=selfish-backend
OTEL_SERVICE_VERSION=dev
